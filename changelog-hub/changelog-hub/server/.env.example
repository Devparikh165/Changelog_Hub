# ─── App ──────────────────────────────────────────────────────────────────
APP_NAME="Changelog Hub"
# development | test | production
NODE_ENV=development
PORT=8000

# ─── Database (MongoDB) ───────────────────────────────────────────────────
# Local MongoDB (installed, or `npm run db:up` with Docker). For MongoDB Atlas
# paste your mongodb+srv://… connection string instead.
MONGODB_URI=mongodb://127.0.0.1:27017/changelog_hub

# ─── JWT pair tokens ──────────────────────────────────────────────────────
# Two different random strings of 32+ characters. `npm run setup` (project root) fills them in.
# Or generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# tolerate two tabs refreshing at the same moment
REFRESH_REUSE_GRACE_SECONDS=10

# ─── Cookies ──────────────────────────────────────────────────────────────
# must be true in production (HTTPS)
COOKIE_SECURE=false
# "none" only if frontend and API are on different sites (+ COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ─── URLs ─────────────────────────────────────────────────────────────────
# comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# used in email links and feed URLs
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# ─── Email simulation ─────────────────────────────────────────────────────
# emails go to MongoDB + console, readable at /dev/mailbox
EMAIL_SIMULATION=true
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ─── Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# ─── Rate limiting (login, signup, forgot/reset password) ────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=300
BCRYPT_ROUNDS=12

# ─── First admin (created on startup if it doesn't exist) ────────────────
ADMIN_EMAIL=admin@changelog.dev
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME="Release Admin"
