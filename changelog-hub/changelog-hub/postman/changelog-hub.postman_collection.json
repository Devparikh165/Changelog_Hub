                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Revokes the presented refresh token and issues a new pair. Replaying an old token revokes the whole session family."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));"
