# Where the Vite dev server proxies /api and /uploads (the Express API in server/)
VITE_API_PROXY_TARGET=http://localhost:8000
# Leave empty in dev (same-origin via proxy). Set when the SPA is served from a different origin than the API.
VITE_API_URL=
# Name of the product whose updates this site publishes
VITE_PRODUCT_NAME=Tempo
